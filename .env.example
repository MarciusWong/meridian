# All keys are optional. The tool works with none of them.

# Port the API (and, in production, the built UI) is served on.
PORT=8787

# Google PageSpeed Insights API key (free): https://developers.google.com/speed/docs/insights/v5/get-started
# Without it Google frequently rate-limits anonymous calls and the tool falls back to local Lighthouse.
PSI_API_KEY=

# Globalping token (free account) raises the hourly measurement limit: https://dash.globalping.io
GLOBALPING_TOKEN=

# Optional WebPageTest API key for real-browser loads from WPT locations.
WPT_API_KEY=

# Path to a Chrome/Chromium binary for local Lighthouse runs (auto-detected when unset).
CHROME_PATH=

# Lighthouse source: auto (PSI, then local), psi, local, off
LIGHTHOUSE_MODE=auto

# Set to true only for testing sites on your own network (disables SSRF protection).
ALLOW_PRIVATE_TARGETS=false
