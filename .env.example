# Meridian configuration. Copy to .env and edit — every setting is optional.
# `npm start` and `npm run dev` load .env automatically.

# --- Server ------------------------------------------------------------------
PORT=8787
# Interface to listen on.
HOST=0.0.0.0
# Behind a reverse proxy or load balancer, set this so rate limits see real client
# IPs: "true", a hop count such as "1", or the proxy's address/CIDR.
TRUST_PROXY=

# --- Data sources (free) -----------------------------------------------------
# Google PageSpeed Insights API key — recommended. Adds real-user (CrUX) data and
# avoids anonymous quota errors. https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=
# Globalping token — raises the hourly probe limit above the anonymous 250 per IP.
# https://dash.globalping.io
GLOBALPING_TOKEN=
# WebPageTest API key — optional real-browser loads from WPT locations.
WPT_API_KEY=

# --- Lighthouse --------------------------------------------------------------
# auto  = PageSpeed Insights, falling back to local Chrome
# psi   = PageSpeed Insights only
# local = local Chrome only
# off   = skip Lighthouse
LIGHTHOUSE_MODE=auto
# Chrome/Chromium binary for local runs. Auto-detected when empty.
CHROME_PATH=

# --- Limits & privacy ---------------------------------------------------------
# Tests each client (IP) may start per hour. 0 = unlimited.
RATE_LIMIT_PER_HOUR=10
# Tests running at the same time across all clients.
MAX_CONCURRENT_JOBS=3
# Show every visitor a shared list of recent reports. Off by default: each browser
# then keeps its own history. Turn on only for private/team instances.
PUBLIC_HISTORY=false
# Delete stored reports after this many days. 0 = keep forever.
REPORT_RETENTION_DAYS=30
# Where reports are stored as JSON.
DATA_DIR=data/reports
# Allow testing private/local network addresses. Only for self-hosted instances
# on a trusted network — this disables SSRF protection.
ALLOW_PRIVATE_TARGETS=false
