{
  "name": "global-pagespeed",
  "version": "1.0.0",
  "private": true,
  "description": "Measure a website's speed from cities around the world and get a prioritised list of fixes.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:dots": "node scripts/build-world-dots.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/compression": "^1.8.1",
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "d3-geo": "^3.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0",
    "typescript": "5.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  }
}
