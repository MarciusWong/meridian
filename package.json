{
  "name": "meridian",
  "version": "1.0.0",
  "private": true,
  "description": "Measure how fast a website loads from cities around the world and get a prioritised list of fixes. Built on Globalping, Lighthouse and PageSpeed Insights.",
  "keywords": [
    "performance",
    "page-speed",
    "web-vitals",
    "lighthouse",
    "globalping",
    "pagespeed-insights",
    "ttfb",
    "cdn",
    "monitoring"
  ],
  "homepage": "https://github.com/MarciusWong/meridian#readme",
  "bugs": {
    "url": "https://github.com/MarciusWong/meridian/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarciusWong/meridian.git"
  },
  "license": "MIT",
  "author": "Marcius Wong",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts --dev",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "build:dots": "node scripts/build-world-dots.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/compression": "^1.8.1",
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-geo": "^3.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0",
    "typescript": "7.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  }
}
